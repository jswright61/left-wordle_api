[Unit]
Description=Left Wordle API — Production (Puma)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
# PATH and the bundle path below are filled in by `cap production puma:setup`
# from the Ruby version pinned in api/.ruby-version (see lib/capistrano/tasks/rv.rake).
# Re-run that setup task after any Ruby version bump to refresh this file.
Environment=HOME=/home/deploy
Environment=PATH=__RV_PATH__
Environment=RACK_ENV=production
Environment=DEPLOY_TO=/home/deploy/left_wordle_api

WorkingDirectory=/home/deploy/left_wordle_api/current
ExecStart=__RV_RUBY_BIN__/bundle exec puma -C config/puma.rb
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=007

[Install]
WantedBy=multi-user.target

# --- One-time server setup notes ---
# 1. Upload this file: cap production puma:setup
# 2. Allow deploy user to manage the service without a password:
#      echo 'deploy ALL=(ALL) NOPASSWD: /bin/systemctl start left-wordle-api, /bin/systemctl stop left-wordle-api, /bin/systemctl reload-or-restart left-wordle-api, /bin/systemctl reload left-wordle-api, /bin/systemctl restart left-wordle-api, /bin/systemctl daemon-reload, /bin/systemctl enable left-wordle-api, /bin/systemctl status left-wordle-api' | sudo tee /etc/sudoers.d/left-wordle-api
# 3. Allow Caddy to access the puma socket via the deploy group:
#      sudo usermod -a -G deploy caddy

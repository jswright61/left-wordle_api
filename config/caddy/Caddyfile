# Each snippet lives in its own file under /etc/caddy/snippets/ (tracked here
# as config/caddy/snippets/*.conf) -- add, edit, or remove a snippet there and
# this import doesn't need to change. Must come before "import sites-enabled"
# below since site configs reference these snippets by name.
import /etc/caddy/snippets/*.conf

# Import specific sites
import /etc/caddy/sites-enabled/*

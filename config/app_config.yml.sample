# Left Wordle API — per-environment application configuration
#
# Copy this file to shared/config/app_config.yml on the server and fill in real values.
# Capistrano symlinks it into each release as config/app_config.yml.
# The real file is gitignored — do not commit it.
#
# One-time server setup:
#   mkdir -p /home/deploy/<deploy_path>/shared/config
#   cp api/config/app_config.yml.sample /home/deploy/<deploy_path>/shared/config/app_config.yml
#   # then edit to set the real values

# Exact origins the browser may send in an Origin header.
# No trailing slash. Multiple origins can be listed.
cors_origins:
  - https://left-wordle.com

# URL used by the guesser's "Play Wordle" link. No trailing slash.
# dev: http://127.0.0.1:3000, staging: https://staging.left-wordle.com
wordle_base_url: https://left-wordle.com

# Bearer token required for server-to-server requests (no Origin header).
# All Origin-less requests must include: Authorization: Bearer <token>
# In development and test, "1234" is always accepted as a convenience token.
# server_api_token: your_secret_token_here

# SMTP credentials for the POST /api/v1/diagnostics endpoint.
# Use an app-specific password from your Fastmail account settings.
# smtp_from defaults to smtp_username when omitted.
smtp_username: your_fastmail_address@fastmail.com
smtp_password: your_app_specific_password
# smtp_from: optional_from_override@example.com

# Postgres connection string. Required in staging/production — set it here,
# never in a checked-in file. Local dev/test need no config: lib/db.rb
# defaults to postgres:///left_wordle_api_#{RACK_ENV} when this is absent,
# which works out of the box with a local trust-auth Postgres install.
database_url: postgres://left_wordle:your_password@localhost/left_wordle_api_production

# WebAuthn (passkey login). The browser origin that invokes
# navigator.credentials — must exactly match, scheme and host, what the
# frontend is actually served from (no trailing slash).
# dev: http://localhost:3000, staging: https://staging.left-wordle.com
webauthn_origin: https://left-wordle.com

# Relying Party ID credentials are scoped to. Defaults to webauthn_origin's
# host when omitted, which is correct for this app's same-origin
# deployments. Select the permanent value before any real user registers a
# passkey in production — credentials cannot move to a different RP ID
# later. See api/docs/security_architecture.md.
# webauthn_rp_id: left-wordle.com

# How long an issued session cookie remains valid.
session_token_ttl_days: 365

# How long a QR/email device-link token remains redeemable.
device_link_token_ttl_minutes: 15

# Secret used to derive CSRF tokens and sign pending WebAuthn ceremony
# cookies (HMAC-SHA256). Required in production -- the app refuses to boot
# without it. Generate with: ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
session_secret: your_random_secret_here
